{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node",
      "@webgpu/types"
    ],
    "paths": {
      "player-study/*": [
        "../player/src/*"
      ],
      "player-study-e2e/*": [
        "../player/e2e/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "e2e/**/*",
    "playwright.config.ts",
    "build.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(wc:*)",
      "Bash(jq:*)",
      "Bash(backend/gradlew:*)",
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(npm install*)",
      "Bash(npm test*)",
      "Bash(npm ls*)",
      "Bash(node *)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git blame:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose start:*)",
      "Bash(docker compose stop:*)",
      "Bash(docker compose restart:*)",
      "Bash(docker compose config:*)",
      "Bash(docker ps:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/require-approval-policy-files.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/remind-docs-review.sh"
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/require-feature-branch-for-commit.sh"
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/require-local-git-identity.sh"
          },
          {
            "type": "command",
            "if": "Bash(find *)",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-unscoped-find.sh"
          },
          {
            "type": "command",
            "if": "Bash(docker run*)",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-bare-docker-run.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/require-relative-gradlew.sh"
          }
        ]
      }
    ]
  }
}

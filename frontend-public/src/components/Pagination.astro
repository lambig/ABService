---
import type { PageHref } from '$lib/pagination';

/**
 * ページ送り。
 *
 * ページ番号を全部並べると、件数が増えたときに導線そのものが読めなくなる。前後と現在地だけを出し、
 * たどれることを保つ（#197 の「全件を辿れる」）。1ページに収まるときは何も出さない。
 */
interface Props {
  readonly currentPage: number;
  readonly totalPages: number;
  readonly hrefOf: PageHref;
}

const { currentPage, totalPages, hrefOf } = Astro.props;

/*
 * 判定は式にせずここへ出す。テンプレートの中の `<` は、Astro のパーサがタグの開始として読む。
 */
const hasMultiplePages = totalPages > 1;
const hasPrevious = currentPage > 1;
const hasNext = totalPages > currentPage;
---

{
  /*
   * 前後が無い側は出さない（#343）。押せるように見える文字が押せないのは、たどれない理由が端にあると
   * 読ませてしまう。
   *
   * 3つの列で置き、それぞれが自分の列を名指しする。詰める形（横並びのまま端を落とす）にすると、
   * 現在地の表示が端の有無でページごとに左右へ動く——読み手が同じ場所を見続けられなくなる。
   */
}
{
  hasMultiplePages ? (
    <nav class="grid grid-cols-3 items-center py-6 text-sm" aria-label="ページ送り">
      {hasPrevious ? (
        <a
          class="justify-self-start underline underline-offset-4"
          href={hrefOf(currentPage - 1)}
          rel="prev"
        >
          前のページ
        </a>
      ) : null}

      <span class="text-muted-foreground col-start-2 justify-self-center tabular-nums">
        {currentPage} / {totalPages}
      </span>

      {hasNext ? (
        <a
          class="col-start-3 justify-self-end underline underline-offset-4"
          href={hrefOf(currentPage + 1)}
          rel="next"
        >
          次のページ
        </a>
      ) : null}
    </nav>
  ) : null
}

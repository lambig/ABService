---
import PreviewMeta from '$components/PreviewMeta.astro';
import { renderPageFrame } from 'abservice-public-presentation';
import type { PublicAlbumDetail } from '$lib/api/client';
import { copyrightHolder, siteDescription, siteName } from '$lib/site';
import '../styles/global.css';

interface Props {
  /** ページの名前。ブラウザのタブと OG では、サイト名と並べて出る。トップのように名前を持たないページは省く */
  readonly title?: string;
  /** ページの説明。検索結果と OG に出る。省いたときはサイトの説明を使う */
  readonly description?: string;
  /**
   * リンクプレビューの元になる作品。
   *
   * <p>
   * 持たないページは省く（既定の画像になる）。**ページ側でプレビューのメタを組まない**——層を分けると
   * 同じ種類のメタが複数並び、読む側がどれを採るかで見え方が変わる（#341）。
   * </p>
   */
  readonly previewAlbum?: PublicAlbumDetail;
}

const { title, description, previewAlbum } = Astro.props;

const name = await siteName();

/*
 * ページの名前とサイト名を並べる（#230 が site.name の用途に挙げるうちの1つ）。名前を持たないページは
 * サイト名だけにする。トップでサイト名が二度並ぶのを避けるため。
 */
const documentTitle = title === undefined ? name : `${title} ― ${name}`;

/* ページ固有の説明が無ければサイトの説明を出す。どちらも無ければメタ説明そのものを出さない */
const metaDescription = description ?? (await siteDescription());

/*
 * 正規URLと OG の絶対URLは site（環境変数で与える）を基準に組む。ドメインをコードへ書かないため、
 * ここでは Astro.site 以外から絶対URLを作らない。
 */
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const frameHtml = renderPageFrame(
  {
    name,
    isHome: title === undefined,
    copyrightHolder: (await copyrightHolder()) ?? null,
    year: new Date().getFullYear(),
  },
  await Astro.slots.render('default'),
  await Astro.slots.render('nav'),
);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalUrl} />

    {
      /*
      サイトの印（#341）。SVG ひとつで足りる——タブが要る大きさは環境で違い、ラスタを並べると
      どれが出所か分からなくなる。中身と、これが既定である経緯は `public/favicon.svg` が持つ。
    */
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      /*
      書体が届くまで覆う印（#361）。描かれる前に付ける必要があるため、ここで同期に実行する
      （`is:inline` はバンドルへ回さない指示）。**書体の stylesheet より前に置く**——後ろに置くと、
      パーサは保留中の stylesheet が片付くまでこのスクリプトを実行できず、その間 body のパースごと
      止まる。JS が動かない環境では印が付かず、覆いも出ない。
    */
    }
    <script is:inline>
      document.documentElement.setAttribute('data-fonts-loading', '');
    </script>

    {
      /*
      本文の書体（#341）。取得元は CSP の style-src / font-src が許す必要があり、許可の実体は #240 が持つ。
      読み込みが済むまでは global.css の後段（OS の標準）で表示する。
    */
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Klee+One:wght@400;600&display=swap"
      data-font-stylesheet
    />
    <title>{documentTitle}</title>
    {metaDescription ? <meta name="description" content={metaDescription} /> : null}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:site_name" content={name} />
    <meta property="og:url" content={canonicalUrl} />
    {metaDescription ? <meta property="og:description" content={metaDescription} /> : null}

    <PreviewMeta album={previewAlbum} />
  </head>

  <body class="bg-background text-foreground min-h-screen">
    {
      /*
      書体が届くまでの覆い（#361）。見た目と、長引いたときに出す印は `global.css` が持つ。支援技術は
      覆いの下の内容を読むため、覆いは `aria-hidden` にする。
    */
    }
    <div class="font-loading-cover" aria-hidden="true"></div>

    <Fragment set:html={frameHtml} />

    {
      /*
      覆いを外す（#361）。外すのは「書体が使える」と分かったとき、「届かない」と分かったとき、待ち時間の
      上限に達したときのいずれか早いもの。**上限が要るのは、応答が返らない回線でも内容を読めなければ
      ならないため。** 外した後に書体が届いた場合は、`display=swap` がそのまま差し替える。

      `document.fonts.ready` だけでは足りない。あれは「読み込み中のフォント面が無い」状態を返すだけで、
      取得元の stylesheet がまだ届いていなければ面そのものが登録されておらず、即座に解決してしまう。
      stylesheet の到着を待ってから、書体の実体を要求する。要求だけでも足りない——`load` が取りに行くのは
      渡した文字が属する範囲（`unicode-range`）だけで、画面の仮名や漢字は別の範囲にある。実体の要求で
      「読み込み中」に入れてから `ready` で締める。
    */
    }
    <script is:inline>
      (() => {
        const SHOW_CONTENT_AFTER_MS = 3000;
        const BODY_FONT = '1em "Klee One"';

        const uncover = () => {
          document.documentElement.removeAttribute('data-fonts-loading');
        };

        const stylesheet = document.querySelector('link[data-font-stylesheet]');
        const settled = (link) => (link === null ? true : link.sheet !== null);

        const delivered = new Promise((resolve) => {
          if (settled(stylesheet)) {
            resolve();
            return;
          }
          stylesheet.addEventListener('load', () => resolve());
          stylesheet.addEventListener('error', () => resolve());
        });

        const usable = () => document.fonts.load(BODY_FONT).then(() => document.fonts.ready);

        /* 失敗したときも外す。取得元へ届かない回線で、上限まで塞いだままにしないため */
        void delivered.then(usable).then(uncover, uncover);
        setTimeout(uncover, SHOW_CONTENT_AFTER_MS);
      })();
    </script>
  </body>
</html>

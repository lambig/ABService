---
import { siteDescription, siteName } from '$lib/site';
import '../styles/global.css';

interface Props {
  /** ページの名前。ブラウザのタブと OG では、サイト名と並べて出る。トップのように名前を持たないページは省く */
  readonly title?: string;
  /** ページの説明。検索結果と OG に出る。省いたときはサイトの説明を使う */
  readonly description?: string;
}

const { title, description } = Astro.props;

const name = await siteName();

/*
 * ページの名前とサイト名を並べる（#230 が site.name の用途に挙げるうちの1つ）。名前を持たないページは
 * サイト名だけにする。トップでサイト名が二度並ぶのを避けるため。
 */
const documentTitle = title === undefined ? name : `${title} ― ${name}`;

/*
 * ページ固有の名前を持たないページ（トップ）では、サイト名がそのページの見出しになる。名前を持つページ
 * では、見出しはそのページ自身が出すため、ヘッダーのサイト名は見出しにしない。
 */
const SiteNameTag = title === undefined ? 'h1' : 'p';

/* ページ固有の説明が無ければサイトの説明を出す。どちらも無ければメタ説明そのものを出さない */
const metaDescription = description ?? (await siteDescription());

/*
 * 正規URLと OG の絶対URLは site（環境変数で与える）を基準に組む。ドメインをコードへ書かないため、
 * ここでは Astro.site 以外から絶対URLを作らない。
 */
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{documentTitle}</title>
    {metaDescription ? <meta name="description" content={metaDescription} /> : null}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:site_name" content={name} />
    <meta property="og:url" content={canonicalUrl} />
    {metaDescription ? <meta property="og:description" content={metaDescription} /> : null}

    {/* ページごとのリンクプレビュー（アルバム詳細のプレイヤーカード・カバー画像） */}
    <slot name="head" />
  </head>

  <body class="bg-background text-foreground min-h-screen">
    {
      /*
      広い幅では器ごと広げる（#357）。導線を脇へ出したぶん本文の幅が削られるため、器を据え置くと
      読む幅だけが狭くなる。広げた先で本文が受け持つのは 60rem ほどで、導線を持たないときの
      64rem とほぼ同じになる。
    */
    }
    <div class="mx-auto flex min-h-screen max-w-5xl flex-col px-4 lg:max-w-6xl">
      <header class="py-6">
        {/* 書体が持つ太さは 400 と 600 の2つだけのため、階層は大きさと 600 で付ける（#344） */}
        <SiteNameTag class="text-2xl font-semibold">
          <a class="underline-offset-4 hover:underline" href="/">{name}</a>
        </SiteNameTag>
      </header>

      {
        /*
        広い幅では導線を本文の脇へ置く（#357）。狭い幅では段が落ち、導線は本文の上に戻る——脇へ
        置いたままだと、読む幅が導線のぶんだけ削られる。切り替えは `lg`（1024px）で、E2E が見る
        広い幅（1280）と狭い幅（390）の両方がこの境の反対側に来る。
      */
      }
      <div class="flex-1 lg:grid lg:grid-cols-[9rem_1fr] lg:gap-10">
        <slot name="nav" />

        <main class="min-w-0">
          <slot />
        </main>
      </div>

      <footer class="text-muted-foreground border-border border-t py-6 text-sm">
        <slot name="footer" />
      </footer>
    </div>
  </body>
</html>

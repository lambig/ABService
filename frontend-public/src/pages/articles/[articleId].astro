---
import { renderArticle } from 'abservice-public-presentation';
import { PUBLIC_ASSET_BASE_PATH } from 'astro:env/client';
import { defaultArtistName } from '$lib/site';
import SiteNav from '$components/SiteNav.astro';
import {
  getAlbum,
  getArticle,
  listArticles,
  type PublicAlbumDetail,
  type PublicArticleDetail,
} from '$lib/api/client';
import { referencedAlbumId } from '$lib/article';
import BaseLayout from '$layouts/BaseLayout.astro';

/*
 * 公開中の記事の分だけページを作る。参照先アルバムはここで引く（一覧検索では揃えない。#197）。
 */
export const getStaticPaths = async () => {
  const articles = await listArticles();
  const details = await Promise.all(articles.map((article) => getArticle(article.articleId)));
  return Promise.all(
    details.map(async (article) => {
      const albumId = referencedAlbumId(article);
      const album = albumId === null ? null : await getAlbum(albumId);
      return {
        params: { articleId: article.articleId },
        props: { article, album },
      };
    }),
  );
};

interface Props {
  readonly article: PublicArticleDetail;
  /** 参照先アルバム。ALBUM 種別で参照を持つときだけ値がある */
  readonly album: PublicAlbumDetail | null;
}

const { article, album } = Astro.props;

const articleHtml = renderArticle(
  { ...article, album },
  PUBLIC_ASSET_BASE_PATH,
  (await defaultArtistName()) ?? null,
);

/*
 * ショート紹介文は一覧のためのもので、詳細には出さない（#197）。メタ説明にも渡さない。作品の概要説明と
 * 同じ理由で、長さと記法が本文に依存するため。
 */
---

<BaseLayout title={article.title} previewAlbum={album ?? undefined}>
  <SiteNav slot="nav" />

  <Fragment set:html={articleHtml} />
</BaseLayout>

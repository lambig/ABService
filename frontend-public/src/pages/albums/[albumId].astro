---
import { renderAlbum } from 'abservice-public-presentation';
import { PUBLIC_ASSET_BASE_PATH } from 'astro:env/client';
import KindMark from '$components/KindMark.astro';
import SiteNav from '$components/SiteNav.astro';
import { getAlbum, listAlbums, type PublicAlbumDetail } from '$lib/api/client';
import { defaultArtistName } from '$lib/site';
import BaseLayout from '$layouts/BaseLayout.astro';

/*
 * 公開中のアルバムの分だけページを作る。一覧で ID を集め、詳細をまとめて取得してから配る
 * （ページごとに取りに行くより往復が減る）。
 */
export const getStaticPaths = async () => {
  const albums = await listAlbums();
  const details = await Promise.all(albums.map((album) => getAlbum(album.albumId)));
  return details.map((album) => ({
    params: { albumId: album.albumId },
    props: { album },
  }));
};

interface Props {
  readonly album: PublicAlbumDetail;
}

const { album } = Astro.props;

const albumHtml = renderAlbum(album, PUBLIC_ASSET_BASE_PATH, {
  defaultArtistName: await defaultArtistName(),
});
---

<BaseLayout title={album.title} previewAlbum={album}>
  <SiteNav slot="nav" />
  <article class="flex gap-3 py-6">
    <KindMark kind="work" />
    <div class="min-w-0 flex-1"><Fragment set:html={albumHtml} /></div>
  </article>
</BaseLayout>

---
import SiteNav from '$components/SiteNav.astro';
import BaseLayout from '$layouts/BaseLayout.astro';

/*
 * トップの中身（サイトの文言・最新の作品や記事の導線）は後続の作業で入れる。
 *
 * サイト名や紹介文は SiteContent（管理画面から登録する）を引いて描くため、リポジトリに文言を置かない。
 */
---

<BaseLayout title="ABService">
  <SiteNav slot="header" />

  <p class="text-muted-foreground py-12">準備中</p>
</BaseLayout>

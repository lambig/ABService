---
import ArticleList from '$components/ArticleList.astro';
import SiteNav from '$components/SiteNav.astro';
import { listArticles } from '$lib/api/client';
import { renderBody } from '$lib/markup';
import { homeIntroduction } from '$lib/site';
import BaseLayout from '$layouts/BaseLayout.astro';

/** トップに並べる記事の件数（#197。全体を辿るのは記事一覧の役割） */
const ARTICLE_COUNT = 5;

const introduction = await homeIntroduction();

/*
 * 紹介文は Markdown（#230）。プレーンテキストの場合はそのまま出す（Astro がエスケープする）。
 * 未登録なら区画ごと出さない。文言はリポジトリに置かないため、代わりの文を用意しない。
 */
const introductionHtml =
  introduction?.contentFormat === 'MARKDOWN' ? renderBody(introduction.content) : null;

const articles = (await listArticles()).slice(0, ARTICLE_COUNT);

/*
 * このページ自身の見出しは置かない。トップの主題はサイトそのもので、ヘッダーのサイト名がその見出しに
 * なる（BaseLayout がページ名の有無で決める）。記事の区画はその下にぶら下がる。
 */
---

<BaseLayout>
  <SiteNav slot="header" />

  {
    introduction === undefined ? null : introductionHtml === null ? (
      <p class="py-6 whitespace-pre-wrap">{introduction.content}</p>
    ) : (
      <div class="prose-body py-6" set:html={introductionHtml} />
    )
  }

  <section class="space-y-4 py-6">
    <h2 class="text-lg font-medium">記事</h2>
    <ArticleList articles={articles} headingLevel="h3" />
  </section>
</BaseLayout>

#!/bin/bash
#
# Git pre-commit hook
# Runs code quality checks before allowing commit
#
# Installation:
#   This hook is automatically set up. If you need to reinstall:
#   ./scripts/setup-git-hooks.sh
#
# To bypass this hook (not recommended):
#   git commit --no-verify
#

set -e

echo "🔍 Running pre-commit checks..."

# Get the list of staged Java files
STAGED_JAVA_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.java$' | grep '^backend/' || true)

if [ -z "$STAGED_JAVA_FILES" ]; then
    echo "✅ No Java files to check"
    exit 0
fi

echo "📝 Checking Java files:"
echo "$STAGED_JAVA_FILES" | sed 's/^/  - /'
echo ""

# Change to backend directory
cd backend

# Run spotless format
echo "🔧 Running spotless format..."
if ./gradlew spotlessApply --quiet; then
    echo "✅ Code formatted"
else
    echo "❌ Spotless format failed"
    exit 1
fi

# Run checkstyle
echo "🔍 Running checkstyle..."
if ./gradlew checkstyleMain checkstyleTest --quiet; then
    echo "✅ Checkstyle passed"
else
    echo "❌ Checkstyle found issues"
    echo ""
    echo "Please fix checkstyle violations before committing."
    echo "Run './gradlew checkstyleMain checkstyleTest' to see details."
    exit 1
fi

echo ""
echo "⚠️  Auto-formatted files need to be staged:"
echo "   git add -u"
echo "   git commit"
echo ""
echo "✅ Pre-commit checks completed"
exit 0

[Unit]
Description=Refresh short-lived credentials for the monitoring agent
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=abservice-monitor
Group=abservice-monitor
UMask=0077
RuntimeDirectory=abservice-monitor
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/python3 /opt/abservice/monitor-credentials/refresh.py --config /etc/abservice/monitor-credentials.json --runtime-directory /run/abservice-monitor
TimeoutStartSec=60
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LimitCORE=0

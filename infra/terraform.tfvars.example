# このファイルをコピーして terraform.tfvars を作成し、実際の値を設定する。
# terraform.tfvars 自体は .gitignore 対象（実際のドメイン名等をリポジトリに残さないため）。
#
#   cp terraform.tfvars.example terraform.tfvars

domain_name = "<your-domain>"

# アラームの通知先。SNS からの購読確認メールが2通（主リージョンと us-east-1）届き、両方を踏むまで通知は届かない（#168）
alarm_email = "<alerts@your-domain>"

# 以下は変更したい場合のみ上書きする（デフォルトはvariables.tf参照）
# aws_region        = "ap-northeast-1"
# ec2_instance_type = "t4g.small"
# db_instance_class = "db.t4g.micro"

# 資格情報の更新（#127）。値を変えて apply すると対応する資格情報が再生成される。順序は infra/README.md「資格情報の更新」
# admin_api_key_rotation       = "initial"
# db_password_rotation         = "initial"
# origin_verify_token_rotation = "initial"

# 復旧（#130）。復元点を入れると別インスタンスが現れる。確かめてから db_active を "restored" にして再配布する。
# 順序と戻し方は infra/README.md「バックアップと復旧」
# db_restore_to_time             = "2026-09-16T00:00:00Z"
# db_restore_snapshot_identifier = "<snapshot id>"
# db_active                      = "main"
# db_main_snapshot_identifier    = "<snapshot id>"
# db_deletion_protection         = true
# db_final_snapshot_generation   = "initial"

# 準備だけでは DNS を向け替えない。採用後の切り戻しは infra/README.md を参照。
dns_cutover_enabled = false
serve_www           = false

public_indexing_enabled = false

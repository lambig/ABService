<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <!-- Suppress checks for generated code -->
    <suppress checks=".*" files=".*[\\/]generated[\\/].*"/>
    <suppress checks=".*" files=".*[\\/]build[\\/].*"/>

    <!-- try/catch 禁止（DomainNoTryCatch）は production の domain 層のみに適用。それ以外は抑制する -->
    <suppress id="DomainNoTryCatch"
        files="^(?!.*[\\/]src[\\/]main[\\/]java[\\/]com[\\/]abservice[\\/]domain[\\/]).*$"/>

    <!-- 可変コレクション生成禁止（NoMutableCollectionInstantiation）は production 全域に適用。
         JPAエンティティのコレクションフィールド初期化・管理コレクション変異のみを行う
         infrastructure.persistence 境界のみ例外とする（#78。旧DomainNoMutableCollectionから拡張） -->
    <suppress id="NoMutableCollectionInstantiation"
        files="^(?!.*[\\/]src[\\/]main[\\/]java[\\/]).*$"/>
    <suppress id="NoMutableCollectionInstantiation"
        files=".*[\\/]src[\\/]main[\\/]java[\\/]com[\\/]abservice[\\/]infrastructure[\\/]persistence[\\/].*"/>

    <!-- 中置論理演算子禁止（ForbiddenLogicalOperators）は production コード（src/main/java）のみに適用。テスト等は抑制 -->
    <suppress id="ForbiddenLogicalOperators"
        files="^(?!.*[\\/]src[\\/]main[\\/]java[\\/]).*$"/>

    <!-- フィールド/クラス/publicメソッドJavadoc必須は domain.model 配下のみに適用（#99） -->
    <suppress id="DomainModelFieldJavadoc"
        files="^(?!.*[\\/]src[\\/]main[\\/]java[\\/]com[\\/]abservice[\\/]domain[\\/]model[\\/]).*$"/>
    <suppress id="DomainModelTypeJavadoc"
        files="^(?!.*[\\/]src[\\/]main[\\/]java[\\/]com[\\/]abservice[\\/]domain[\\/]model[\\/]).*$"/>
    <suppress id="DomainModelMethodJavadoc"
        files="^(?!.*[\\/]src[\\/]main[\\/]java[\\/]com[\\/]abservice[\\/]domain[\\/]model[\\/]).*$"/>

    <!-- インラインコメントのwhy notプレフィックス必須（InlineCommentRequiresWhyNotPrefix）は
         production コード（src/main/java）のみに適用。テスト等は抑制（#99） -->
    <suppress id="InlineCommentRequiresWhyNotPrefix"
        files="^(?!.*[\\/]src[\\/]main[\\/]java[\\/]).*$"/>
</suppressions>

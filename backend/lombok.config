# Lombok 生成コードに @lombok.Generated を付与する（1.18.34+ の既定を明示）。
# これにより NullAway が Lombok 生成メソッド（wither/getter/コンストラクタ等）を
# 検査対象外として扱い、生成コード起因の誤検知を避ける。
lombok.addLombokGeneratedAnnotation = true
config.stopBubbling = true

# @Nullable をフィールドから Lombok 生成物（getter/wither/コンストラクタ引数）へコピーし、
# 生成コードの nullability を正しく伝播させる（NullAway が生成物の契約を正しく解釈できる）。
lombok.copyableAnnotations += org.jspecify.annotations.Nullable

# @ConfigProperty をフィールドから Lombok 生成コンストラクタの引数へコピーする。
# CommandService/QueryService は @AllArgsConstructor でコンストラクタを生成する規約のため、
# 設定値を注入する場合もこの規約を崩さずに済むようにする。
lombok.copyableAnnotations += org.eclipse.microprofile.config.inject.ConfigProperty

# ABService 環境変数
# `.env` へコピーして必要な値を書き換える（`.env` は .gitignore 対象）。
# ここに列挙するのは backend の `application.properties` が実際に参照する変数のみ。
#
# ローカル開発・テストは docker compose（docker/README.md）で起動する PostgreSQL / MinIO を前提に、
# `application.properties` 側の既定値だけで動作する。既定値から変えたい項目のみ設定する。
#
# 本番（prod プロファイル）ではDB接続情報と管理者APIキーに既定値がなく、未設定なら起動に失敗する。
# 値は Parameter Store（SecureString）から `deploy.sh` が取得してコンテナへ渡すため、
# 本番向けにこのファイルを配置する運用はしない（infra/README.md）。

# Database
# 接続先はホスト・ポート・DB名で与える。backend が JDBC と reactive の両URLをここから組み立てるため、
# 用途ごとに別のURLを渡す必要はない。
DB_HOST=localhost
DB_PORT=5432
DB_NAME=abservice
DB_USERNAME=abservice
DB_PASSWORD=abservice

# 管理操作（Command系API・管理向けQuery API）に要求するAPIキー。
# クライアントは Authorization: Bearer <ADMIN_API_KEY> を付与する。
ADMIN_API_KEY=dev-admin-api-key

# CORS
# 本番は単一ドメイン・パスベースルーティングで同一オリジンになるため不要（既定は無効）。
# dev・test プロファイルでは常に有効。別オリジン構成にする場合のみ両方を対で設定する。
CORS_ENABLED=false
CORS_ORIGINS=http://localhost:5173,http://localhost:4321

# アセット保管（S3互換）
# ローカルは docker compose の MinIO（バケットは minio-init が作成）。
# 本番は実S3・EC2インスタンスプロファイルで動作するため、エンドポイントと静的キーは prod プロファイルで空になる。
ASSETS_BUCKET=abservice-assets
AWS_REGION=ap-northeast-1
S3_ENDPOINT_OVERRIDE=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123

# 発行SQLのログ出力（調査時のみ有効にする）
QUARKUS_HIBERNATE_ORM_LOG_SQL=false

# 本番デプロイ時に docker-compose.prod.yml が参照する backend イメージ参照。
# CI（deploy.yml → SSM Run Command → deploy.sh）が設定するため手で書く必要はない。
# BACKEND_IMAGE=<account>.dkr.ecr.<region>.amazonaws.com/abservice-backend:<tag>

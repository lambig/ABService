---
import { ALBUM_LIST_PATH, ARTICLE_LIST_PATH } from '$lib/paths';

import '../styles/global.css';

interface Props {
  /** 画面の名前。ブラウザのタブに出る */
  readonly title: string;
}

const { title } = Astro.props;

/** 集約ごとの入口。ここに無い画面（新規作成・編集）は、それぞれの一覧から辿る */
const ENTRIES = [
  { label: '作品', href: ALBUM_LIST_PATH },
  { label: '記事', href: ARTICLE_LIST_PATH },
] as const;

/*
 * 管理画面はサイト名や紹介文（SiteContent。#230）を引かない。あれは公開サイトの見えかたを決める
 * ものであり、運用者が使う画面の見出しではない。名前はリポジトリ側に置く。
 */
const APPLICATION_NAME = 'ABService 管理';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* 検索の対象にしない。運用者しか使わない画面で、公開の導線を持たない */}
    <meta name="robots" content="noindex, nofollow" />
    <title>{`${title} ― ${APPLICATION_NAME}`}</title>
  </head>

  <body class="bg-background text-foreground min-h-screen">
    {/* 広い幅では器ごと広げる（#357）。理由と幅は公開サイトと揃える */}
    <div class="mx-auto flex min-h-screen max-w-5xl flex-col px-4 lg:max-w-6xl">
      {
        /*
        アプリ名と画面名はヘッダーに残す（#357）。画面名は「いまどこにいるか」で、導線とは役割が違う。
        導線だけを脇へ移す。
      */
      }
      <header class="border-border flex items-baseline gap-3 border-b py-6">
        <p class="text-lg font-medium">{APPLICATION_NAME}</p>
        <p class="text-muted-foreground text-sm">{title}</p>
      </header>

      {/* 広い幅では導線を本文の脇へ置く（#357）。切り替えと追従の扱いは公開サイトと揃える */}
      <div class="flex-1 py-6 lg:grid lg:grid-cols-[9rem_1fr] lg:gap-10">
        <nav
          class="border-border mb-6 border-b pb-4 lg:sticky lg:top-6 lg:mb-0 lg:self-start lg:border-b-0 lg:pb-0"
          aria-label="主要な導線"
        >
          <ul class="flex items-center gap-4 lg:flex-col lg:items-start lg:gap-3">
            {
              ENTRIES.map((entry) => (
                <li>
                  <a class="text-sm underline underline-offset-4" href={entry.href}>
                    {entry.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <main class="min-w-0">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>

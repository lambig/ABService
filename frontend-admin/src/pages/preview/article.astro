---
import 'abservice-public-presentation/public.css';
/* 下書きや認証情報をビルド出力へ入れない。親の編集画面が同一オリジンのフレームへ描画する。 */
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <!-- 子のSoundCloudは動作させるが、この文書自身のスクリプトはCSPで禁止する。 -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; script-src 'none'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' https: http:; frame-src https://w.soundcloud.com; base-uri 'none'; form-action 'none'"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Klee+One:wght@400;600&display=swap"
    />
    <title>記事のプレビュー</title>
  </head>
  <body class="bg-background text-foreground min-h-screen"><div id="article-preview"></div></body>
</html>
